<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Step definitions for the Pickle suite in ../Mod/Pickle/Features. Only Pickle loads this
    assembly: it lives in the companion test mod, never in the mod's own Mod/ folder.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>FlavorTextExtended.PickleSteps</AssemblyName>
    <RootNamespace>FlavorTextExtended.PickleSteps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\Mod\Pickle\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Flavor Text's own assembly, compiled against and never copied: the game loads it long before Pickle loads this one. -->
    <FlavorTextDll Condition="'$(FlavorTextDll)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3245374432\1.6\Assemblies\FlavorText.dll</FlavorTextDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time stubs only: the game and the Pickle mod supply the real assemblies. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.Pickle.Ref" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FlavorText">
      <HintPath>$(FlavorTextDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
