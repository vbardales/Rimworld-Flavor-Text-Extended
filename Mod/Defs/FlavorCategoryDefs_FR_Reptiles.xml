<?xml version="1.0" encoding="utf-8" ?>
<!--
  Sous-catégories de FT_Meat_Herp.

  Flavor Text range tortue, iguane, alligator, varan, ouaouaron et crapaud colosse
  dans une seule catégorie. Impossible dans ces conditions d'écrire une soupe de
  tortue qui se déclenche sur la tortue : elle sortirait aussi bien sur l'iguane.

  On scinde donc en cinq branches, sur le modèle reptiles / amphibiens :
    FT_Meat_Turtle    tortue, tortue de mer
    FT_Meat_Alligator alligator, et par mots-clés crocodile et caïman
    FT_Meat_Iguana    iguane
    FT_Meat_Lizard    varan et lézards
    FT_Meat_Frog      ouaouaron et grenouilles (amphibien, pas reptile)

  Le crapaud colosse reste volontairement dans FT_Meat_Herp seul : il ne matchera
  que les plats génériques, jamais une recette nommée. Celui du jeu est une créature
  d'Odyssey, pas le Rhinella marina toxique — mais rien n'oblige à en faire un civet.

  Les formes grammaticales sont héritées de FT_MeatRaw : « viande de tortue », etc.
-->
<Defs>

	<FlavorText.FlavorCategoryDef>
		<defName>FT_Meat_Turtle</defName>
		<label>Flavor Text turtle meat</label>
		<parents>
			<li>FT_Meat_Herp</li>
		</parents>
		<keywords>
			<li>turtle</li>
			<li>tortoise</li>
			<li>terrapin</li>
			<li>tortue</li>
			<li>sea turtle</li>
			<li>snapping turtle</li>
			<li>soft-shell turtle</li>
		</keywords>
		<thingDefsToAbsorb>
			<li>Meat_Tortoise</li>
			<li MayRequire="ludeon.rimworld.odyssey">Meat_SeaTurtle</li>
		</thingDefsToAbsorb>
	</FlavorText.FlavorCategoryDef>

	<FlavorText.FlavorCategoryDef>
