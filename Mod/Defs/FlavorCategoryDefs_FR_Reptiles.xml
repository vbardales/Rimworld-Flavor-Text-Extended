<!--
  Subcategories of FT_Meat_Herp.

  Flavor Text lumps tortoise, iguana, alligator, monitor lizard, bullfrog and giant toad
  into a single category. Under those conditions it is impossible to write a turtle
  soup that triggers on the tortoise: it would just as well come out for the iguana.

  So we split it into five branches, following a reptiles / amphibians model:
    FT_Meat_Turtle    tortoise, sea turtle
    FT_Meat_Alligator alligator, and by keywords crocodile and caiman
    FT_Meat_Iguana    iguana
    FT_Meat_Lizard    monitor lizard and lizards
    FT_Meat_Frog      bullfrog and frogs (amphibian, not reptile)

  The giant toad deliberately stays alone in FT_Meat_Herp: it will only match
  generic dishes, never a named recipe. The in-game one is an Odyssey creature,
  not the toxic Rhinella marina - but nothing requires making a stew out of it.

  Grammatical forms are inherited from FT_MeatRaw: "turtle meat", etc.

  FOUR of the six meats cited by name come from Odyssey and therefore carry a MayRequire:
  alligator, monitor lizard, bullfrog and sea turtle. Only the tortoise and the iguana are in Core.
  Without the guard, a game without Odyssey fails to resolve the reference on load.

  The categories themselves stay declared whatever the mod list: their keywords still
  attach a crocodile or a gecko coming from another mod, which a guard placed on the
  whole def would lose.

  Flavor Text keeps these same three meats with MayRequire="RimWorld.Odyssey", which lacks
  the publisher prefix. A mistyped packageId is silent outside Ludeon's Unity editor:
  on their side those lines drop out even when Odyssey is present. Do not use it as a model.
-->
<Defs>

	<FlavorText.FlavorCategoryDef>
		<defName>FT_Meat_Turtle</defName>
		<label>Flavor Text turtle meat</label>
		<parents>
			<li>FT_Meat_Herp</li>
		</parents>
		<keywords>
			<li>turtle</li>
			<li>tortoise</li>
			<li>terrapin</li>
			<li>tortue</li>
			<li>sea turtle</li>
			<li>snapping turtle</li>
			<li>soft-shell turtle</li>
		</keywords>
		<thingDefsToAbsorb>
			<li>Meat_Tortoise</li>
			<li MayRequire="ludeon.rimworld.odyssey">Meat_SeaTurtle</li>
		</thingDefsToAbsorb>
	</FlavorText.FlavorCategoryDef>

	<FlavorText.FlavorCategoryDef>
		<defName>FT_Meat_Alligator</defName>
		<label>Flavor Text alligator meat</label>
		<parents>
			<li>FT_Meat_Herp</li>
		</parents>
		<keywords>
			<li>alligator</li>
			<li>gator</li>
			<li>crocodile</li>
			<li>croc</li>
			<li>caiman</li>
			<li>caïman</li>
		</keywords>
		<thingDefsToAbsorb>
			<li MayRequire="ludeon.rimworld.odyssey">Meat_Alligator</li>
		</thingDefsToAbsorb>
	</FlavorText.FlavorCategoryDef>

	<FlavorText.FlavorCategoryDef>
		<defName>FT_Meat_Iguana</defName>
		<label>Flavor Text iguana meat</label>
		<parents>
			<li>FT_Meat_Herp</li>
		</parents>
		<keywords>
			<li>iguana</li>
			<li>iguane</li>
			<li>garrobo</li>
		</keywords>
		<thingDefsToAbsorb>
			<li>Meat_Iguana</li>
		</thingDefsToAbsorb>
	</FlavorText.FlavorCategoryDef>

	<FlavorText.FlavorCategoryDef>
		<defName>FT_Meat_Lizard</defName>
		<label>Flavor Text lizard meat</label>
		<parents>
			<li>FT_Meat_Herp</li>
		</parents>
		<keywords>
			<li>monitor lizard</li>
			<li>monitor</li>
			<li>varan</li>
			<li>goanna</li>
			<li>gecko</li>
		</keywords>
		<thingDefsToAbsorb>
			<li MayRequire="ludeon.rimworld.odyssey">Meat_MonitorLizard</li>
		</thingDefsToAbsorb>
	</FlavorText.FlavorCategoryDef>

	<FlavorText.FlavorCategoryDef>
		<defName>FT_Meat_Frog</defName>
		<label>Flavor Text frog meat</label>
		<parents>
			<li>FT_Meat_Herp</li>
		</parents>
		<keywords>
			<li>frog</li>
			<li>bullfrog</li>
			<li>grenouille</li>
			<li>ouaouaron</li>
		</keywords>
		<thingDefsToAbsorb>
			<li MayRequire="ludeon.rimworld.odyssey">Meat_Bullfrog</li>
		</thingDefsToAbsorb>
	</FlavorText.FlavorCategoryDef>

</Defs>
