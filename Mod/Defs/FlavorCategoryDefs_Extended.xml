<?xml version="1.0" encoding="utf-8" ?>
<!--
  Ingredient categories missing from Flavor Text but essential to French cooking.

  Categorization compares each ThingDef's defName AND label against the keywords. The
  defName stays in English whatever the language, while the label is translated: so the
  keywords are given in both languages.

  Grammatical forms (singularCollective, inflectionsOverride) are inherited from the
  parent - nothing to redefine here.
-->
<Defs>

	<FlavorText.FlavorCategoryDef>
		<defName>FT_Leek</defName>
		<label>Flavor Text leek</label>
		<parents>
			<li>FT_Vegetable</li>
		</parents>
		<keywords>
			<li>leek</li>
			<li>leeks</li>
			<li>poireau</li>
			<li>poireaux</li>
			<li>ramson</li>
			<li>wild leek</li>
		</keywords>
		<thingDefsToAbsorb>
			<li MayRequire="vvenchov.vvnewharvest">VV_Leeks</li>
		</thingDefsToAbsorb>
	</FlavorText.FlavorCategoryDef>

	<FlavorText.FlavorCategoryDef>
		<defName>FT_Shallot</defName>
		<label>Flavor Text shallot</label>
		<parents>
			<li>FT_Onion</li>
		</parents>
		<keywords>
			<li>shallot</li>
			<li>shallots</li>
			<li>échalote</li>
			<li>echalote</li>
			<li>scallion</li>
		</keywords>
		<!-- No verified explicit shallot provider. Matching keywords still classify real ingredients. -->
	</FlavorText.FlavorCategoryDef>

</Defs>
