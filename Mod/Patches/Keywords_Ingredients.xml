<?xml version="1.0" encoding="utf-8" ?>
<!--
  Additional ingredient keywords for Flavor Text categories.
Water caltrop (Trapa natans, singhara) is botanically distinct from Chinese water
chestnut (Eleocharis dulcis), but shares its culinary category here.
-->
<Patch>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FlavorText.FlavorCategoryDef[defName="FT_WaterChestnut"]/keywords</xpath>
		<value>
			<li>singhara</li>
			<li>singhada</li>
			<li>water caltrop</li>
			<li>chataigne d'eau</li>
			<li>châtaigne d'eau</li>
			<li>matai</li>
		</value>
	</Operation>

	<!--
  Quince and crabapple use the apple category for their related culinary uses.
-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FlavorText.FlavorCategoryDef[defName="FT_Apple"]/keywords</xpath>
		<value>
			<li>quince</li>
			<li>coing</li>
			<li>membrillo</li>
			<li>marmelo</li>
			<li>ayva</li>
			<li>crabapple</li>
		</value>
	</Operation>

</Patch>
