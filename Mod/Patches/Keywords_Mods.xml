<?xml version="1.0" encoding="utf-8" ?>
<!--
  Additional keyword matches and explicit third-party ingredient attachments.
Flavor Text reads both defNames and labels. Multiword/compound ingredient names
can still fail its keyword scoring. Finished named meals are deliberately excluded:
these additions classify ingredients, not existing dishes.
-->
<Patch>

	<!--
  Honeycomb and its alternate names.
-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FlavorText.FlavorCategoryDef[defName="FT_SugarFromAnimals"]/keywords</xpath>
		<value>
			<li>honeycomb</li>
			<li>honey comb</li>
			<li>rayon de miel</li>
		</value>
	</Operation>

	<!--
  Okara / soy pulp is a tofu by-product.
-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FlavorText.FlavorCategoryDef[defName="FT_Soy"]/keywords</xpath>
		<value>
			<li>okara</li>
			<li>unohana</li>
			<li>soy pulp</li>
		</value>
	</Operation>

	<!--
  Compound berry names and French keywords.
-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FlavorText.FlavorCategoryDef[defName="FT_Berry"]/keywords</xpath>
		<value>
			<li>marrowberry</li>
			<li>marrowberries</li>
			<li>baie</li>
			<li>baies</li>
		</value>
	</Operation>

	<!--
  Edible arthropod ingredient keywords.
-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FlavorText.FlavorCategoryDef[defName="FT_Meat_Insect"]/keywords</xpath>
		<value>
			<li>tarantula</li>
			<li>spider</li>
			<li>arachnid</li>
			<li>scorpion</li>
			<li>cricket</li>
			<li>locust</li>
			<li>grub</li>
			<li>larva</li>
			<li>larvae</li>
		</value>
	</Operation>

	<!--
  Keep animal-feed ingredients in the animal-food category.
-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FlavorText.FlavorCategoryDef[defName="FT_AnimalFoods"]/keywords</xpath>
		<value>
			<li>alfalfa</li>
			<li>fodder</li>
			<li>chaff</li>
			<li>feedstock</li>
			<li>animal treat</li>
			<li>animal treats</li>
			<li>grazing</li>
			<li>forage</li>
		</value>
	</Operation>

	<!--
  Explicit dried-meat and cheese attachments for RimLife Expansion Trading items.
Japanese labels do not by themselves imply a mismatch; defNames are also considered.
Each ingredient entry is guarded by the provider package ID.
-->
	<Operation Class="PatchOperationAdd" MayRequire="daylight.RimLifeExTRGMod">
		<xpath>Defs/FlavorText.FlavorCategoryDef[defName="FT_MeatRaw"]/thingDefsToAbsorb</xpath>
		<value>
			<li MayRequire="daylight.RimLifeExTRGMod">RLE_DriedMeat</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd" MayRequire="daylight.RimLifeExTRGMod">
		<xpath>Defs/FlavorText.FlavorCategoryDef[defName="FT_Cheese"]/thingDefsToAbsorb</xpath>
		<value>
			<li MayRequire="daylight.RimLifeExTRGMod">RLE_CheesNatureAfter</li>
			<li MayRequire="daylight.RimLifeExTRGMod">RLE_CheesNatureAged</li>
		</value>
	</Operation>

</Patch>
