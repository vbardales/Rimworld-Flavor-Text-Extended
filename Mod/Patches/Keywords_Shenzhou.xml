<?xml version="1.0" encoding="utf-8" ?>
<!--
  Chinese Traditional Cultural Things Expanded: explicit raw-ingredient attachments.
The historical providers use Dajian.ChiTeaditional.Expanded.OldMode (2371079000)
and Dajian.ChiTeaditional.Expanded (2877536640). Their installed metadata was recorded
as supporting up to 1.3 and 1.5 respectively, not 1.6; this is not a certification of
those providers on 1.6. Check actual provider versions before the optional game test.
Flavor Text matches defNames as well as labels. Non-Latin labels alone are not proof
that these ingredients need a patch. Entries explicitly establish category membership.
MayRequireAnyOf on each value entry permits either provider. Finished named dishes
and inedible wrapping leaves are deliberately excluded.
-->
<Patch>

	<!--
  Highland barley: grain and flour.
-->
	<Operation Class="PatchOperationAdd" MayRequireAnyOf="Dajian.ChiTeaditional.Expanded.OldMode,Dajian.ChiTeaditional.Expanded">
		<xpath>Defs/FlavorText.FlavorCategoryDef[defName="FT_Barley"]/thingDefsToAbsorb</xpath>
		<value>
			<li MayRequireAnyOf="Dajian.ChiTeaditional.Expanded.OldMode,Dajian.ChiTeaditional.Expanded">RawQingKe</li>
			<li MayRequireAnyOf="Dajian.ChiTeaditional.Expanded.OldMode,Dajian.ChiTeaditional.Expanded">WorkedQingKe</li>
		</value>
	</Operation>

